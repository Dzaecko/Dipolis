{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Stadtmodell: Nachbetrachtung",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "RemoteSigned", "-File", "${workspaceFolder}\\scripts\\start-city-review.ps1",
        "-Protocol", { "value": "${input:cityReviewProtocol}", "quoting": "strong" },
        "-Adapter", { "value": "${input:cityReviewAdapter}", "quoting": "strong" }
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Stadtmodell: Wiedergabe öffnen",
      "dependsOn": ["Stadtmodell: Wiedergabe Dev-Server", "Stadtmodell: Wiedergabe Browser öffnen"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Stadtmodell: Wiedergabe Dev-Server",
      "type": "shell",
      "command": "corepack",
      "args": ["pnpm", "--filter", "micropolis", "run", "dev:vite", "--", "--strictPort"],
      "options": { "cwd": "${workspaceFolder}", "env": { "VITE_PORT": "5188" } },
      "isBackground": true,
      "problemMatcher": {
        "owner": "city-replay-server",
        "pattern": [{ "regexp": ".*" }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:.*5188"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "Stadtmodell: Wiedergabe Browser öffnen",
      "type": "shell",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-Command", "Start-Process 'http://localhost:5188/replay'"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Stadtmodell: Berichte neu erzeugen",
      "type": "shell",
      "command": "corepack",
      "args": ["pnpm", "--filter", "micropolis", "run", "city-report", "--all"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Stadtmodell: Auftrag N fortsetzen",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "RemoteSigned", "-File", "${workspaceFolder}\\scripts\\start-city-model.ps1",
        "-Run", { "value": "${input:cityModelRun}", "quoting": "strong" },
        "-Handbook", { "value": "${input:cityModelHandbook}", "quoting": "strong" },
        "-Assignment", "N", "-Resume",
        "-Review", { "value": "${input:cityModelReview}", "quoting": "strong" }
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] }
      },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true, "close": false },
      "problemMatcher": []
    },
    {
      "label": "Stadtmodell: Auftrag N live starten",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "RemoteSigned", "-File", "${workspaceFolder}\\scripts\\start-city-model.ps1",
        "-Run", { "value": "${input:cityModelRun}", "quoting": "strong" },
        "-Handbook", { "value": "${input:cityModelHandbook}", "quoting": "strong" },
        "-StartMap", { "value": "${input:cityModelStartMap}", "quoting": "strong" },
        "-Profile", { "value": "${input:cityModelProfile}", "quoting": "strong" },
        "-Seed", { "value": "${input:cityModelSeed}", "quoting": "strong" },
        "-Assignment", "N",
        "-Review", { "value": "${input:cityModelReview}", "quoting": "strong" }
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true,
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Stadtmodell: Auftrag R live starten",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "RemoteSigned", "-File", "${workspaceFolder}\\scripts\\start-city-model.ps1",
        "-Run", { "value": "${input:cityModelRun}", "quoting": "strong" },
        "-Handbook", { "value": "${input:cityModelHandbook}", "quoting": "strong" },
        "-StartMap", { "value": "${input:cityModelStartMap}", "quoting": "strong" },
        "-Profile", { "value": "${input:cityModelProfile}", "quoting": "strong" },
        "-Seed", { "value": "${input:cityModelSeed}", "quoting": "strong" },
        "-Assignment", "R",
        "-Review", { "value": "${input:cityModelReview}", "quoting": "strong" }
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] }
      },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true, "close": false },
      "problemMatcher": []
    },
    {
      "label": "Stadtmodell: Auftrag R fortsetzen",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "RemoteSigned", "-File", "${workspaceFolder}\\scripts\\start-city-model.ps1",
        "-Run", { "value": "${input:cityModelRun}", "quoting": "strong" },
        "-Handbook", { "value": "${input:cityModelHandbook}", "quoting": "strong" },
        "-Assignment", "R", "-Resume",
        "-Review", { "value": "${input:cityModelReview}", "quoting": "strong" }
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] }
      },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true, "close": false },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "cityReviewProtocol",
      "type": "promptString",
      "description": "Pfad zum vollstaendigen JSONL-Protokoll (absolut oder relativ zum Repository)"
    },
    {
      "id": "cityReviewAdapter",
      "type": "pickString",
      "description": "Nachbetrachtung: fake ist lokal, openai erzeugt drei echte Modellanfragen und Kosten",
      "options": ["fake", "openai"],
      "default": "fake"
    },
    {
      "id": "cityModelReview",
      "type": "pickString",
      "description": "Nachbetrachtung nach dem Lauf (on erzeugt zusaetzliche Modellkosten)",
      "options": ["off", "on"],
      "default": "off"
    },
    {
      "id": "cityModelProfile",
      "type": "pickString",
      "description": "Simulationsprofil fuer einen neuen Lauf (Fortsetzen erbt das gespeicherte Profil)",
      "options": ["classic", "koexistenz", "v2-unruhe", "v3-pods", "v4-fraktion"],
      "default": "koexistenz"
    },
    {
      "id": "cityModelRun",
      "type": "promptString",
      "description": "Laufnummer (positive ganze Zahl; zum Fortsetzen die vorhandene Nummer)",
      "default": "1"
    },
    {
      "id": "cityModelHandbook",
      "type": "pickString",
      "description": "Handbuch fuer diesen Lauf verwenden?",
      "options": ["on", "off"],
      "default": "off"
    },
    {
      "id": "cityModelStartMap",
      "type": "pickString",
      "description": "Startkarte fuer einen neuen Lauf",
      "options": ["natural", "haight"],
      "default": "natural"
    },
    {
      "id": "cityModelSeed",
      "type": "promptString",
      "description": "Deterministischer Startwert (0 bis 2147483647)",
      "default": "42"
    }
  ]
}
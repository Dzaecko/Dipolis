# Kopieren nach .env.city-model; niemals Zugangsdaten committen.
CITY_MODEL_ENDPOINT=
CITY_MODEL_NAME=
CITY_MODEL_KEY=
CITY_MODEL_ASSIGNMENT=N
CITY_MODEL_RUN=
CITY_MODEL_TIMEOUT_MS=60000
CITY_MODEL_MAX_RETRIES=5
# Optional: none for models requiring disabled reasoning with chat function tools.
CITY_MODEL_REASONING_EFFORT=
# chat (default) or responses; Responses supports function tools with reasoning models.
CITY_MODEL_API=chat